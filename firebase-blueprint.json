{
  "entities": {
    "Entrega": {
      "title": "Entrega",
      "description": "Custom real-time Brazilian delivery and load monitoring record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "data_coleta": { "type": "string" },
        "vendedor": { "type": "string" },
        "cliente": { "type": "string" },
        "tel_cliente": { "type": "string" },
        "motorista": { "type": "string" },
        "tel_motorista": { "type": "string" },
        "origem": { "type": "string" },
        "destino": { "type": "string" },
        "frete_empresa": { "type": "number" },
        "frete_motorista": { "type": "number" },
        "prazo": { "type": "string" },
        "status": { "type": "string", "enum": ["coletando", "em_transito", "parado", "entregue"] },
        "observacoes": { "type": "string" },
        "link_localizacao": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "canhoto_solicitado": { "type": "boolean" },
        "updated_at": { "type": "string", "format": "date-time" },
        "userId": { "type": "string" },
        "historico": {
          "type": "array",
          "description": "List of tracked action events made to this delivery",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "timestamp": { "type": "string", "format": "date-time" },
              "usuario": { "type": "string" },
              "usuarioNome": { "type": "string" },
              "cargo": { "type": "string" },
              "descricao": { "type": "string" }
            }
          }
        }
      },
      "required": [
        "data_coleta",
        "vendedor",
        "cliente",
        "tel_cliente",
        "motorista",
        "tel_motorista",
        "origem",
        "destino",
        "frete_empresa",
        "frete_motorista",
        "prazo",
        "status",
        "observacoes",
        "lat",
        "lng",
        "canhoto_solicitado"
      ]
    },
    "ScheduledMessage": {
      "title": "ScheduledMessage",
      "description": "WhatsApp notification schedulers linked to the delivery record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "deliveryId": { "type": "string" },
        "deliveryDriver": { "type": "string" },
        "deliveryDestiny": { "type": "string" },
        "recipientName": { "type": "string" },
        "recipientPhone": { "type": "string" },
        "recipientType": { "type": "string", "enum": ["motorista", "cliente"] },
        "scheduledTime": { "type": "string" },
        "messageText": { "type": "string" },
        "status": { "type": "string", "enum": ["pendente", "enviado", "cancelado"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "userId": { "type": "string" }
      },
      "required": [
        "deliveryId",
        "deliveryDriver",
        "deliveryDestiny",
        "recipientName",
        "recipientPhone",
        "recipientType",
        "scheduledTime",
        "messageText",
        "status",
        "createdAt"
      ]
    },
    "UserSettings": {
      "title": "UserSettings",
      "description": "User specific initialization and settings flag",
      "type": "object",
      "properties": {
        "seeded": { "type": "boolean" },
        "userId": { "type": "string" }
      },
      "required": ["seeded", "userId"]
    },
    "BlacklistMotorista": {
      "title": "BlacklistMotorista",
      "description": "Blacklisted drivers who are forbidden from being registered in the system",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nome": { "type": "string" },
        "cpf": { "type": "string" },
        "telefone": { "type": "string" },
        "observacao": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "usuarioNome": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["nome", "cpf", "telefone", "observacao", "created_at"]
    },
    "GroupChatMessage": {
      "title": "GroupChatMessage",
      "description": "Futuristic company-wide logs and group messaging for Rodovar Transportes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "category": { "type": "string", "enum": ["comercial", "operacional"] },
        "text": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userRole": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "attachmentName": { "type": "string" },
        "attachmentType": { "type": "string" },
        "attachmentPreview": { "type": "string" },
        "audioUrl": { "type": "string" },
        "isVoiceNote": { "type": "boolean" },
        "isAiTriggered": { "type": "boolean" },
        "aiAgentResponse": { "type": "string" }
      },
      "required": ["category", "text", "userId", "userName", "userRole", "timestamp"]
    }
  },
  "firestore": {
    "/user_settings/{userId}": {
      "schema": "UserSettings",
      "description": "User specific initialization and settings flag"
    },
    "/entregas/{entregaId}": {
      "schema": "Entrega",
      "description": "Brazilian deliveres monitored in real-time"
    },
    "/scheduled_messages/{messageId}": {
      "schema": "ScheduledMessage",
      "description": "Scheduled WhatsApp reminders for monitored deliveries"
    },
    "/blacklist_motoristas/{blacklistId}": {
      "schema": "BlacklistMotorista",
      "description": "Motoristas bloqueados e proibidos de trabalhar na frota Rodovar"
    },
    "/group_chat_messages/{messageId}": {
      "schema": "GroupChatMessage",
      "description": "Real-time collaborative chat posts under Comercial and Operacional channels"
    }
  }
}
