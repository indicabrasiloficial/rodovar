rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Regras para entregas/cargas (leitura pública para rastreio e operações)
    match /entregas/{entregaId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Acesso geral do ambiente para colaboradores e sistemas
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
