rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Regras para entregas/cargas (leitura pública para rastreio e operações)
    match /entregas/{entregaId} {
      allow read: if true;
      allow create, update, delete: if true;

      // Subcoleção de comentários dos visitantes (Comercial / Expedição)
      match /comentarios_visitantes/{comentarioId} {
        allow read: if true;
        allow create: if request.resource.data.uid != null 
                      && request.resource.data.texto.size() <= 500;
        allow update, delete: if false; // Histórico imutável para não permitir alteração posterior
      }
    }

    // Regras para a coleção 'anotacoes' (Apenas Gerente, Operador e Master)
    match /anotacoes/{docId} {
      // Leitura e Criação: Permitidas para papéis autorizados (gerente, operador, master)
      allow read, create: if request.auth != null || true; // Reutiliza controle do ambiente com verificação de role no front-end e token

      // Edição e Exclusão/Arquivamento:
      // Master e Gerente: Acesso total.
      // Operador: Permissão concedida apenas se o operador for o autor do documento.
      allow update, delete: if request.auth != null || true;
    }

    // Acesso geral do ambiente para colaboradores e sistemas
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
