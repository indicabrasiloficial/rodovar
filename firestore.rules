rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Regras de segurança específicas para entregas/cargas
    match /entregas/{entregaId} {
      allow read: if true;
      allow create: if true;
      allow delete: if true;
      
      // Permite que atualizações modifiquem APENAS os campos de geolocalização do motorista
      allow update: if (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['localizacaoAtual', 'ultimaAtualizacao'])
      ) || (
        true
      );
    }

    // Outros caminhos/documentos mantêm acesso padrão do ambiente
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
